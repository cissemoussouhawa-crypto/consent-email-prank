# متغیرهای محیطی نمونه

# گیرنده‌ای که پیام‌ها به آن ارسال می‌شود
RECIPIENT_EMAIL=cissemoussouhawa@gmail.com

# پورت سرور
PORT=3000

# تنظیمات SMTP (مثال: Gmail SMTP با App Password یا سرویس SMTP دیگر)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# از چه ایمیلی نمایش داده شود (اختیاری)
SMTP_FROM="Prank App <no-reply@example.com>"
